<style>
  .auth-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 64px 16px;
    background-color: #f9f6f2;
  }
  .auth-box {
    width: 100%;
    max-width: 440px;
  }
  .auth-header {
    text-align: center;
    margin-bottom: 32px;
  }
  .auth-caption {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: #9e8f85;
  }
  .auth-title {
    margin-top: 12px;
    font-size: 32px;
    font-weight: 800;
    color: #0b090a;
  }
  .auth-subtitle {
    margin-top: 10px;
    font-size: 14px;
    color: #555;
  }
  .auth-subtitle a {
    color: #a4161a;
    font-weight: 600;
    text-decoration: none;
  }
  .auth-subtitle a:hover { color: #e5383b; }
  .auth-card {
    background: #fff;
    border-radius: 28px;
    padding: 36px;
    box-shadow: 0 20px 50px rgba(11,9,10,0.08);
  }
  .auth-message {
    display: none;
    margin-bottom: 20px;
    border-radius: 12px;
    padding: 12px 16px;
    font-size: 14px;
  }
  .auth-message.success {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #15803d;
  }
  .auth-message.error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #dc2626;
  }
  .auth-form { display: flex; flex-direction: column; gap: 20px; }
  .form-group { display: flex; flex-direction: column; gap: 8px; }
  .form-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: #9e8f85;
  }
  .form-input {
    width: 100%;
    border: 1px solid #ede8e3;
    border-radius: 12px;
    padding: 12px 16px;
    font-size: 14px;
    color: #0b090a;
    background: #faf8f6;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s;
  }
  .form-input:focus { border-color: #a4161a; }
  .forgot-link {
    text-align: right;
    font-size: 12px;
    color: #a4161a;
    text-decoration: none;
    font-weight: 500;
  }
  .forgot-link:hover { color: #e5383b; }
  .auth-btn {
    width: 100%;
    background: #a4161a;
    color: #fff;
    border: none;
    border-radius: 12px;
    padding: 14px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(164,22,26,0.22);
    transition: background 0.2s;
  }
  .auth-btn:hover { background: #e5383b; }
  .auth-btn:disabled { opacity: 0.7; cursor: not-allowed; }
</style>

<section class="auth-section">
  <div class="auth-box">
    <div class="auth-header">
      <p class="auth-caption">Welcome Back</p>
      <h1 class="auth-title">Sign in to your account</h1>
      <p class="auth-subtitle">Don't have an account? <a href="/register">Register here</a></p>
    </div>
    <div class="auth-card">
      <div id="auth-message" class="auth-message"></div>
      <form id="login-form" class="auth-form">
        <div class="form-group">
          <label class="form-label">Email Address</label>
          <input type="email" id="email" required placeholder="you@example.com" class="form-input" />
        </div>
        <div class="form-group">
          <label class="form-label">Password</label>
          <input type="password" id="password" required placeholder="••••••••" class="form-input" />
        </div>
        <a href="/reset-password" class="forgot-link">Forgot password?</a>
        <button type="submit" id="login-btn" class="auth-btn">Sign In</button>
      </form>
    </div>
  </div>
</section>

<script>
  document.getElementById('login-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('login-btn');
    const msg = document.getElementById('auth-message');
    btn.textContent = 'Signing in…';
    btn.disabled = true;
    msg.className = 'auth-message';
    msg.style.display = 'none';
    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({
          email: document.getElementById('email').value,
          password: document.getElementById('password').value
        })
      });
      const data = await res.json();
      if (data.success) {
        msg.textContent = 'Login successful! Redirecting…';
        msg.className = 'auth-message success';
        msg.style.display = 'block';
        setTimeout(() => window.location.href = '/', 1000);
      } else {
        msg.textContent = data.message || 'Login failed.';
        msg.className = 'auth-message error';
        msg.style.display = 'block';
        btn.textContent = 'Sign In';
        btn.disabled = false;
      }
    } catch {
      msg.textContent = 'Something went wrong.';
      msg.className = 'auth-message error';
      msg.style.display = 'block';
      btn.textContent = 'Sign In';
      btn.disabled = false;
    }
  });
</script>