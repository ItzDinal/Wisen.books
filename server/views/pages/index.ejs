<%
const heroBooks = featuredBooks || [];
const bestBooks = bestsellingBooks || heroBooks;
%>
<section class="relative overflow-hidden bg-wisen-soft py-16 lg:py-28">
  <div class="pointer-events-none absolute right-0 top-0 hidden h-72 w-72 rounded-full bg-gradient-to-br from-wisen.primary/20 via-wisen.soft/40 to-transparent blur-3xl lg:block"></div>
  <div class="container-main grid gap-12 lg:grid-cols-[1.1fr_0.9fr] items-center">
    <div class="relative z-10">
      <span class="hero-caption">Premium secondhand bookstore</span>
      <h1 class="mt-8 max-w-3xl text-5xl font-extrabold leading-tight tracking-tight text-wisen-black sm:text-6xl">
        Crafted collections of elegant pre-loved books.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-wisen-navy/80">
        Discover a refined bookstore experience with curated titles, editorial recommendations and premium secondhand editions for every reading room.
      </p>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <a href="/shop" class="btn-primary">Shop the Collection</a>
        <a href="/blog" class="btn-outline">Explore the Journal</a>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        <div class="rounded-[28px] bg-white/90 p-6 shadow-[0_20px_50px_rgba(11,9,10,0.08)]">
          <p class="text-xs uppercase tracking-[0.3em] text-wisen-taupe">Curated Picks</p>
          <p class="mt-4 text-2xl font-semibold text-wisen-black">A thoughtful selection for every shelf.</p>
        </div>
        <div class="rounded-[28px] bg-white/90 p-6 shadow-[0_20px_50px_rgba(11,9,10,0.08)]">
          <p class="text-xs uppercase tracking-[0.3em] text-wisen-taupe">Reliable Service</p>
          <p class="mt-4 text-2xl font-semibold text-wisen-black">Secure checkout and premium delivery.</p>
        </div>
      </div>
    </div>
    <div class="relative z-10 mx-auto max-w-xl">
      <div class="relative overflow-hidden rounded-[38px] border border-wisen-soft bg-white p-4 shadow-[0_35px_80px_rgba(11,9,10,0.08)]">
        <img src="/images/after.jpg" alt="Featured books" class="h-[560px] w-full rounded-[32px] object-cover transition duration-500 hover:scale-105" />
        <div class="pointer-events-none absolute -right-12 top-8 h-40 w-40 rounded-full bg-gradient-to-br from-wisen-primary/15 to-transparent blur-3xl"></div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/featureStrip') %>

<section class="container-main py-16 fade-section">
  <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="text-sm uppercase tracking-[0.35em] text-wisen-taupe">Customer Favorites</p>
      <h2 class="section-title">Refined Picks</h2>
    </div>
    <a href="/shop" class="btn-outline">View All Books</a>
  </div>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    <% heroBooks.forEach((book) => { %>
      <%- include('../partials/bookCard', { book }) %>
    <% }) %>
  </div>
</section>

<section class="container-main py-16 fade-section">
  <div class="grid gap-6 lg:grid-cols-[1.7fr_1fr]">
    <div class="relative overflow-hidden rounded-[38px] bg-wisen-navy p-10 text-white shadow-[0_35px_80px_rgba(11,9,10,0.18)]">
      <div class="pointer-events-none absolute -right-16 top-8 h-40 w-40 rounded-full bg-wisen-primary/15 blur-3xl"></div>
      <span class="inline-flex rounded-full bg-wisen-primary/15 px-4 py-1 text-xs uppercase tracking-[0.35em] text-wisen.white/90">Seasonal Offer</span>
      <h2 class="mt-6 text-4xl font-semibold leading-tight">Mid-year editorial book sale</h2>
      <p class="mt-5 max-w-xl text-sm leading-7 text-wisen.white/80">Enjoy premium secondhand bundles, rare editions and style-led collections with up to 55% off curated selections.</p>
      <div class="mt-8">
        <a href="/shop" class="btn-secondary">Browse Offers</a>
      </div>
    </div>
    <div class="grid gap-6">
      <div class="rounded-[28px] bg-wisen-bright p-8 text-white shadow-[0_25px_50px_rgba(229,56,59,0.25)]">
        <span class="text-xs uppercase tracking-[0.35em] text-white/90">Flash Price</span>
        <h3 class="mt-4 text-3xl font-bold">Books from $1</h3>
        <p class="mt-4 text-sm leading-7 text-white/85">Limited edition picks refreshed each week for collectors and readers.</p>
      </div>
      <div class="rounded-[28px] bg-wisen-primary p-8 text-white shadow-[0_25px_50px_rgba(164,22,26,0.22)]">
        <span class="text-xs uppercase tracking-[0.35em] text-white/90">Premium Bundle</span>
        <h3 class="mt-4 text-3xl font-bold">Two-book stories</h3>
        <p class="mt-4 text-sm leading-7 text-white/85">A refined bundle of premium titles for your shelf and gift list.</p>
      </div>
    </div>
  </div>
</section>

<section class="container-main py-16 fade-section">
  <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="text-sm uppercase tracking-[0.35em] text-wisen-taupe">Bestselling Books</p>
      <h2 class="section-title">Top bookstore favorites</h2>
    </div>
    <a href="/shop" class="btn-outline">Browse Bestsellers</a>
  </div>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    <% bestBooks.forEach((book) => { %>
      <%- include('../partials/bookCard', { book }) %>
    <% }) %>
  </div>
</section>

<section class="container-main py-16 fade-section">
  <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="text-sm uppercase tracking-[0.35em] text-wisen-taupe">Journal</p>
      <h2 class="section-title">Editorial reading</h2>
    </div>
    <a href="/blog" class="btn-outline">View More Journal</a>
  </div>
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    <% ['Miracle morning with books','Best bookstore Shopify layout ideas','Top 5 books for 2026'].forEach((post) => { %>
      <article class="journal-card bg-white">
        <a href="#" class="block overflow-hidden transition duration-500 hover:scale-[1.02]">
          <img src="/images/placeholder-book.jpg" alt="<%= post %>" class="h-64 w-full object-cover" />
        </a>
        <div class="p-6">
          <p class="text-xs uppercase tracking-[0.3em] text-wisen-taupe">Reading Notes</p>
          <h3 class="mt-4 text-2xl font-semibold text-wisen-navy"><%= post %></h3>
          <p class="mt-3 text-sm leading-7 text-wisen-gray">Editorial insights for thoughtful readers and modern book lovers.</p>
          <a href="#" class="mt-6 inline-flex text-sm font-semibold text-wisen-primary transition hover:text-wisen-accent">Read story →</a>
        </div>
      </article>
    <% }) %>
  </div>
</section>
