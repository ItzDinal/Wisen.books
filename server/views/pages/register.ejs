<section class="min-h-screen bg-wisen-soft flex items-center justify-center py-16 px-4">
  <div class="w-full max-w-md">
    <div class="mb-8 text-center">
      <p class="text-xs uppercase tracking-[0.35em] text-wisen-taupe">Join Wisen Books</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-wisen-black">Create your account</h1>
      <p class="mt-3 text-sm text-wisen-navy/70">Already have an account? <a href="/login" class="font-semibold text-wisen-primary hover:text-wisen-accent transition">Sign in</a></p>
    </div>
    <div class="rounded-[28px] bg-white p-8 shadow-[0_20px_50px_rgba(11,9,10,0.08)]">
      <div id="auth-message" class="hidden mb-6 rounded-xl px-4 py-3 text-sm"></div>
      <form id="register-form" class="space-y-5">
        <div>
          <label class="block text-xs uppercase tracking-[0.25em] text-wisen-taupe mb-2">Full Name</label>
          <input type="text" id="name" required placeholder="Jane Doe"
            class="w-full rounded-xl border border-wisen-soft bg-wisen-soft/50 px-4 py-3 text-sm text-wisen-black placeholder-wisen-taupe/60 outline-none focus:border-wisen-primary focus:ring-2 focus:ring-wisen-primary/10 transition" />
        </div>
        <div>
          <label class="block text-xs uppercase tracking-[0.25em] text-wisen-taupe mb-2">Email Address</label>
          <input type="email" id="email" required placeholder="you@example.com"
            class="w-full rounded-xl border border-wisen-soft bg-wisen-soft/50 px-4 py-3 text-sm text-wisen-black placeholder-wisen-taupe/60 outline-none focus:border-wisen-primary focus:ring-2 focus:ring-wisen-primary/10 transition" />
        </div>
        <div>
          <label class="block text-xs uppercase tracking-[0.25em] text-wisen-taupe mb-2">Password</label>
          <input type="password" id="password" required placeholder="••••••••"
            class="w-full rounded-xl border border-wisen-soft bg-wisen-soft/50 px-4 py-3 text-sm text-wisen-black placeholder-wisen-taupe/60 outline-none focus:border-wisen-primary focus:ring-2 focus:ring-wisen-primary/10 transition" />
        </div>
        <button type="submit" id="register-btn"
          class="w-full rounded-xl bg-wisen-primary px-6 py-3 text-sm font-semibold text-white shadow-[0_8px_24px_rgba(164,22,26,0.22)] transition hover:bg-wisen-accent active:scale-[0.98]">
          Create Account
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  document.getElementById('register-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('register-btn');
    const msg = document.getElementById('auth-message');
    btn.textContent = 'Creating account…';
    btn.disabled = true;
    msg.classList.add('hidden');
    try {
      const res = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({
          name: document.getElementById('name').value,
          email: document.getElementById('email').value,
          password: document.getElementById('password').value
        })
      });
      const data = await res.json();
      if (data.success) {
        msg.textContent = 'Account created! Redirecting…';
        msg.className = 'mb-6 rounded-xl px-4 py-3 text-sm bg-green-50 border border-green-200 text-green-700';
        msg.classList.remove('hidden');
        setTimeout(() => window.location.href = '/', 1000);
      } else {
        msg.textContent = data.message || 'Registration failed.';
        msg.className = 'mb-6 rounded-xl px-4 py-3 text-sm bg-red-50 border border-red-200 text-red-700';
        msg.classList.remove('hidden');
        btn.textContent = 'Create Account';
        btn.disabled = false;
      }
    } catch {
      msg.textContent = 'Something went wrong.';
      msg.className = 'mb-6 rounded-xl px-4 py-3 text-sm bg-red-50 border border-red-200 text-red-700';
      msg.classList.remove('hidden');
      btn.textContent = 'Create Account';
      btn.disabled = false;
    }
  });
</script>