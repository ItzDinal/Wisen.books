<%
const categoryList = categories || [];
%>
<section class="container-main py-10"><h1 class="text-3xl font-bold">Categories</h1><div class="mt-6 grid gap-6 md:grid-cols-[360px_1fr]"><form class="space-y-3 rounded-sm border border-gray-200 p-5"><h2 class="font-semibold">Add Category</h2><input type="text" placeholder="Category name" class="w-full rounded-sm border border-gray-300 px-3 py-2"><button class="btn-primary">Create</button></form><div class="rounded-sm border border-gray-200 bg-white p-5"><h2 class="font-semibold">Existing Categories</h2><ul class="mt-4 space-y-2 text-sm"><% categoryList.forEach((category) => { %><li class="flex justify-between border-b pb-2"><span><%= category.name %></span><a href="#" class="text-red-600">Delete</a></li><% }) %></ul></div></div></section>
