<%
const bookList = books || [];
%>
<section class="container-main py-10"><div class="mb-6 flex items-center justify-between"><h1 class="text-3xl font-bold">Manage Books</h1><a href="/admin/books/create" class="btn-primary">Create New Book</a></div><div class="mb-4"><input type="text" placeholder="Search books" class="w-full max-w-sm rounded-sm border border-gray-300 px-3 py-2"></div><div class="overflow-x-auto rounded-sm border border-gray-200 bg-white"><table class="min-w-full text-sm"><thead class="bg-gray-50"><tr><th class="px-4 py-3 text-left">Book</th><th class="px-4 py-3 text-left">Category</th><th class="px-4 py-3 text-left">Stock</th><th class="px-4 py-3 text-left">Price</th><th class="px-4 py-3 text-left">Actions</th></tr></thead><tbody><% bookList.forEach((book) => { %><tr class="border-t"><td class="px-4 py-3"><%= book.title %></td><td class="px-4 py-3">Fiction</td><td class="px-4 py-3"><%= book.stock %></td><td class="px-4 py-3">$<%= Number(book.price).toFixed(2) %></td><td class="px-4 py-3"><a href="/admin/books/edit/1" class="text-wisen-accent">Edit</a> / <a href="#" class="text-red-600">Delete</a></td></tr><% }) %></tbody></table></div></section>
