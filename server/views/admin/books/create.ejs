<section class="container-main py-10">
    <h1 class="text-3xl font-bold">Create Book</h1>
    <form class="mt-6 grid gap-4 rounded-sm border border-gray-200 p-6 md:grid-cols-2">
        <input type="text" placeholder="Title" class="rounded-sm border border-gray-300 px-3 py-2" required>
        <input type="text" placeholder="Author" class="rounded-sm border border-gray-300 px-3 py-2" required>
        <input type="number" placeholder="Original Price" class="rounded-sm border border-gray-300 px-3 py-2" required>
        <input type="number" placeholder="Secondhand Price" class="rounded-sm border border-gray-300 px-3 py-2" required>
        <input type="text" placeholder="Category" class="rounded-sm border border-gray-300 px-3 py-2" required><input type="number" placeholder="Stock" class="rounded-sm border border-gray-300 px-3 py-2" required>
        <textarea placeholder="Description" rows="5" class="md:col-span-2 rounded-sm border border-gray-300 px-3 py-2">

        </textarea>
        <button class="btn-primary md:col-span-2 w-fit">Save Book</button>
    </form>
</section>
