<article data-book-card data-title="<%= book.title %>" data-author="<%= book.author %>" class="group overflow-hidden rounded-[28px] bg-white shadow-[0_20px_45px_rgba(11,9,10,0.08)] transition duration-300 ease-out hover:-translate-y-1 hover:shadow-xl">
  <div class="relative overflow-hidden">
    <a href="/book/<%= book.id %>"><img src="<%= book.image %>" alt="<%= book.title %>" class="h-72 w-full object-cover transition duration-500 group-hover:scale-105"/></a>
    <% if (book.price < book.originalPrice) { %>
      <span class="absolute left-4 top-4 rounded-full bg-wisen-accent px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.3em] text-white">Sale</span>
    <% } %>
  </div>
  <div class="space-y-3 p-6">
    <p class="text-xs uppercase tracking-[0.25em] text-wisen.taupe"><%= book.author %></p>
    <h3 class="text-lg font-semibold text-wisen-navy"><%= book.title %></h3>
    <div class="flex items-center gap-3">
      <% if (book.price < book.originalPrice) { %>
        <span class="text-sm text-wisen.gray line-through">$<%= book.originalPrice.toFixed(2) %></span>
      <% } %>
      <span class="text-xl font-bold text-wisen.black">$<%= book.price.toFixed(2) %></span>
    </div>
    <button data-add-cart data-id="<%= book.id %>" data-title="<%= book.title %>" data-author="<%= book.author %>" data-price="<%= book.price %>" data-image="<%= book.image %>" class="mt-3 w-full rounded-3xl bg-wisen-navy px-4 py-3 text-sm font-semibold text-white transition duration-300 hover:bg-wisen-primary">Add to Cart</button>
  </div>
</article>
